# Leave MONGODB_URI unset to run on a local SQLite file (instance/stow.sqlite3).
# Set it to use MongoDB instead.
MONGODB_URI=

# Database name, used only when the URI has none in its path. Defaults to stow.
MONGODB_DB=

SQLITE_PATH=

# Signs read tokens. Required in production: if this changes, every open
# protected session is invalidated.
SECRET_KEY=change-me-to-a-long-random-string

# Used for share links, canonical URLs and Open Graph tags.
BASE_URL=http://localhost:5000

# Reject entries larger than this many characters.
MAX_CONTENT_CHARS=500000

# Expiry applied when a request does not ask for one. 0 means never.
DEFAULT_EXPIRY_DAYS=0

PORT=5000
